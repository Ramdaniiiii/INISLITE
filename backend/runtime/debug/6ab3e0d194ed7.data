0:"renderAjax";s:5:"class";s:18:"yii\web\Controller";s:4:"type";s:2:"->";}}}i:224;a:5:{i:0;s:36:"SHOW FULL COLUMNS FROM `collections`";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1790173394.891415;i:4;a:2:{i:0;a:5:{s:4:"file";s:97:"C:\laragon\www\inlislite3\backend\modules\pengkatalogan\views\katalog\_entryBibliografiSimple.php";s:4:"line";i:43;s:8:"function";s:5:"__get";s:5:"class";s:23:"yii\db\BaseActiveRecord";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:89:"C:\laragon\www\inlislite3\backend\modules\pengkatalogan\controllers\KatalogController.php";s:4:"line";i:5821;s:8:"function";s:10:"renderAjax";s:5:"class";s:18:"yii\web\Controller";s:4:"type";s:2:"->";}}}i:226;a:5:{i:0;s:609:"SELECT
    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
