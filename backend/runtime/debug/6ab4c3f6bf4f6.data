    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
    kcu.constraint_name = rc.constraint_name
WHERE rc.constraint_schema = database() AND kcu.table_schema = database()
AND rc.table_name = 'session' AND kcu.table_name = 'session'";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1790231544.1657;i:4;a:0:{}}i:125;a:5:{i:0;s:178:"UPDATE `session` SET `data`='__flash|a:0:{}__returnUrl|s:9:\"/backend/\";location|s:1:\"1\";__id|i:33;taglist|a:0:{}', `expire`=1790253144 WHERE `id`='pba3ahmeeeguk2f93tqvvvs9ag'";i:1;i:80;i:2;s:23:"yii\db\Command::execute";i:3;d:1790231544.16578;i:4;a:0:{}}i:126;a:5:{i:0;s:178:"UPDATE `session` SET `data`='__flash|a:0:{}__returnUrl|s:9:\"/backend/\";location|s:1:\"1\";__id|i:33;taglist|a:0:{}', `expire`=1790253144 WHERE `id`='pba3ahmeeeguk2f93tqvvvs9ag'";i:1;i:96;i:2;s:23:"yii\db\Command::execute";i:3;d:1790231544.166365;i:4;a:0:{}}}}s:6:"assets";a:15:{s:44:"leandrogehlen\querybuilder\QueryBuilderAsset";a:9:{s:10:"sourcePath";s:63:"C:\laragon\www\inlislite3/vendor\bower/jQuery-QueryBuilder/dist";s:2:"js";a:1:{i:0;s:34:"js/query-builder.standalone.min.js";}s:3:"css";a:1:{i:0;s:33:"css/query-builder.default.min.css";}s:7:"depends";a:2:{i:0;s:19:"yii\web\JqueryAsset";i:1;s:41:"leandrogehlen\querybuilder\BootstrapAsset";}s:8:"basePath";s:49:"C:\laragon\www\inlislite3\backend\assets\168e742c";s:7:"baseUrl";s:24:"/backend/assets/168e742c";s:9:"jsOptions";a:0:{}s:10:"cssOptions";a:0:{}s:14:"publishOptions";a:0:{}}s:19:"yii\web\JqueryAsset";a:9:{s:10:"sourcePath";s:50:"C:\laragon\www\inlislite3/vendor\bower/jquery/dist";s:2:"js";a:1:{i:0;s:9:"jquery.js";}s:8:"basePath";s:48:"C:\laragon\www\inlislite3\backend\assets\251f0d2";s:7:"baseUrl";s:23:"/backend/assets/251f0d2";s:7:"depends";a:0:{}s:3:"css";a:0:{}s:9:"jsOptions";a:1:{s:8:"position";i:1;}s:10:"cssOptions";a:0:{}s:14:"publishOptions";a:0:{}}s:41:"leandrogehlen\querybuilder\BootstrapAsset";a:9:{s:10:"sourcePath";s:53:"C:\laragon\www\inlislite3/vendor\bower/bootstrap/dist";s:3:"css";a:1:{i:0;s:17:"css/bootstrap.css";}s:8:"basePath";s:49:"C:\laragon\www\inlislite3\backend\assets\9b05f4f3";s:7:"baseUrl";s:24:"/backend/assets/9b05f4f3";s:7:"depends";a:0:{}s:2:"js";a: